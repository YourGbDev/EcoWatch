# ===========================================
# EcoWatch - Environment Configuration Template
# ===========================================
# Copy this file to .env and update values for your environment
# NEVER commit the actual .env file to version control!

# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_NAME=smart_flood_waste
DB_USER=your_database_user
DB_PASS=your_database_password
DB_CHARSET=utf8mb4

# ===========================================
# Application Configuration
# ===========================================
# Base URL for the application (without trailing slash)
BASE_URL=/smart-flood-waste-monitoring

# ===========================================
# Session Configuration
# ===========================================
# Secret key for session encryption (generate a random 32-char string)
SESSION_SECRET=your_32_character_random_string_here

# ===========================================
# Security Settings
# ===========================================
# Enable HTTPS in production (set to true when using SSL)
SESSION_SECURE=false

# Admin user email (for initial setup)
ADMIN_EMAIL=admin@ecowatch.gov